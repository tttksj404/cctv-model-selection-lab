# Copy to infra/.env.deploy on the EC2 host. Never commit the copied file.
IMAGE_TAG=latest

DEV_MYSQL_DATABASE=eyesonu_dev
DEV_DB_USERNAME=eyesonu_dev
DEV_DB_PASSWORD=change-me
DEV_MYSQL_ROOT_PASSWORD=change-me
DEV_RABBITMQ_USER=eyesonu_dev
DEV_RABBITMQ_PASSWORD=change-me
DEV_RABBITMQ_VHOST=/eyesonu-dev
DEV_AUTH_RATE_LIMIT_KEY_SECRET=change-me
DEV_ADMIN_BOOTSTRAP_LOGIN_ID=admin
DEV_ADMIN_BOOTSTRAP_PASSWORD=change-me
DEV_ADMIN_BOOTSTRAP_NAME=Dev Administrator
DEV_MINIO_ROOT_USER=eyesonu-dev
DEV_MINIO_ROOT_PASSWORD=change-me
DEV_MINIO_BUCKET=eyesonu-media
DEV_MINIO_REGION=ap-northeast-2
DEV_MINIO_APP_ACCESS_KEY=eyesonu-app-dev
DEV_MINIO_APP_SECRET_KEY=change-me
DEV_MINIO_PUBLIC_ENDPOINT=https://storage-dev.13.125.211.107.nip.io
DEV_RECORDING_MAX_FILE_SIZE_BYTES=5368709120

MASTER_MYSQL_DATABASE=eyesonu_prod
MASTER_DB_USERNAME=eyesonu_prod
MASTER_DB_PASSWORD=change-me
MASTER_MYSQL_ROOT_PASSWORD=change-me
MASTER_RABBITMQ_USER=eyesonu_prod
MASTER_RABBITMQ_PASSWORD=change-me
MASTER_RABBITMQ_VHOST=/eyesonu-prod
MASTER_AUTH_RATE_LIMIT_KEY_SECRET=change-me
MASTER_ADMIN_BOOTSTRAP_LOGIN_ID=admin
MASTER_ADMIN_BOOTSTRAP_PASSWORD=change-me
MASTER_ADMIN_BOOTSTRAP_NAME=Production Administrator
MASTER_MINIO_ROOT_USER=eyesonu-prod
MASTER_MINIO_ROOT_PASSWORD=change-me
MASTER_MINIO_BUCKET=eyesonu-media
MASTER_MINIO_REGION=ap-northeast-2
MASTER_MINIO_APP_ACCESS_KEY=eyesonu-app-prod
MASTER_MINIO_APP_SECRET_KEY=change-me
MASTER_MINIO_PUBLIC_ENDPOINT=https://storage-master.13.125.211.107.nip.io
MASTER_RECORDING_MAX_FILE_SIZE_BYTES=5368709120
