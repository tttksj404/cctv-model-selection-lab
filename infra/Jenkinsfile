pipeline {
    agent any

    options {
        timestamps()
        disableConcurrentBuilds()
    }

    environment {
        DEPLOY_COMPOSE = 'infra/compose.deploy.yml'
        DEPLOY_ENV_FILE = 'infra/.env.deploy'
	TESTCONTAINERS_RYUK_DISABLED = 'true'
	TESTCONTAINERS_HOST_OVERRIDE = 'host.docker.internal'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Resolve branch') {
            steps {
                script {
                    def rawBranch = env.gitlabTargetBranch ?: env.BRANCH_NAME ?: env.GIT_BRANCH ?: ''
                    def targetBranch = rawBranch.tokenize('/').last()
                    def mergeRequest = env.gitlabMergeRequestIid?.trim()

                    env.TARGET_BRANCH = targetBranch
                    env.DEPLOY_PROFILE = targetBranch in ['dev', 'master'] ? targetBranch : ''
                    env.CAN_DEPLOY = env.DEPLOY_PROFILE && !mergeRequest ? 'true' : 'false'
                    echo "Target branch: ${targetBranch}, merge request: ${mergeRequest ? 'yes' : 'no'}, deploy: ${env.CAN_DEPLOY}"
                }
            }
        }

        stage('Backend build and test') {
            steps {
                dir('apps/backend-api/eyesonu') {
                    sh './mvnw -B clean verify'
                }
            }
        }

        stage('Frontend build validation') {
            parallel {
                stage('Admin frontend') {
                    steps {
                        dir('apps/frontend/admin-dashboard') {
                            sh 'npm ci'
                            sh 'npm run build'
                        }
                    }
                }
                stage('Reporter frontend') {
                    steps {
                        dir('apps/frontend/reporter-webapp') {
                            sh 'npm ci'
                            sh 'npm run build'
                        }
                    }
                }
            }
        }

        stage('Deploy to EC2 Docker Engine') {
            when {
                expression { env.CAN_DEPLOY == 'true' }
            }
            steps {
                sh '''
                    test -f "$DEPLOY_ENV_FILE"
                    docker compose --env-file "$DEPLOY_ENV_FILE" -f "$DEPLOY_COMPOSE" config >/dev/null
                    sh infra/scripts/cleanup-legacy-containers.sh
                    docker compose --env-file "$DEPLOY_ENV_FILE" -f "$DEPLOY_COMPOSE" \\
                      --profile "$DEPLOY_PROFILE" up -d --build --wait --wait-timeout 180
                    docker compose --env-file "$DEPLOY_ENV_FILE" -f "$DEPLOY_COMPOSE" ps
                '''
            }
        }
    }

    post {
        success {
            script {
                mattermostSend(
                    color: '#00d1b2',
                    message: "[EyesForU CI] ${env.TARGET_BRANCH ?: 'unknown'} pipeline completed\nBuild #${env.BUILD_NUMBER}\n${env.BUILD_URL}"
                )
            }
        }
        failure {
            script {
                mattermostSend(
                    color: '#ff3860',
                    message: "[EyesForU CI] ${env.TARGET_BRANCH ?: 'unknown'} pipeline failed\nBuild #${env.BUILD_NUMBER}\n${env.BUILD_URL}"
                )
            }
        }
    }
}
