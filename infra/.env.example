# Local development only. Copy this file to infra/.env before starting Compose.
COMPOSE_PROJECT_NAME=eyesonu-local
SPRING_PROFILES_ACTIVE=local

# Authentication (local development only)
AUTH_RATE_LIMIT_KEY_SECRET=eyesonu-local-rate-limit-key-change-me
ADMIN_BOOTSTRAP_LOGIN_ID=admin
ADMIN_BOOTSTRAP_PASSWORD=eyesonu-local-admin!
ADMIN_BOOTSTRAP_NAME=Local Administrator

# MySQL
MYSQL_DATABASE=eyesonu
MYSQL_PORT=3307
# Deployment dev DB host port (bound to localhost on EC2)
DEV_DB_HOST_PORT=3309
MYSQL_ROOT_PASSWORD=eyesonu_local_mysql_root
DB_URL=jdbc:mysql://localhost:3307/eyesonu?serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=eyesonu
DB_PASSWORD=eyesonu_local_db

# RabbitMQ
RABBITMQ_USER=eyesonu
RABBITMQ_PASSWORD=eyesonu_local_rabbit
RABBITMQ_VHOST=/eyesonu
RABBITMQ_AMQP_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672

# Values passed to the Spring Boot run configuration
SPRING_RABBITMQ_HOST=localhost
SPRING_RABBITMQ_PORT=5672
SPRING_RABBITMQ_USERNAME=eyesonu
SPRING_RABBITMQ_PASSWORD=eyesonu_local_rabbit
SPRING_RABBITMQ_VIRTUAL_HOST=/eyesonu

# MinIO
MINIO_ROOT_USER=eyesonu-local
MINIO_ROOT_PASSWORD=eyesonu-local-minio-secret
MINIO_BUCKET=eyesonu-media
MINIO_INTERNAL_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_REGION=ap-northeast-2
MINIO_APP_ACCESS_KEY=eyesonu-app
MINIO_APP_SECRET_KEY=eyesonu-app-local-secret
RECORDING_MAX_FILE_SIZE_BYTES=104857600
MINIO_CONNECT_TIMEOUT=3s
MINIO_READ_TIMEOUT=5s
MINIO_CALL_TIMEOUT=10s
MINIO_PRESIGNED_URL_EXPIRY=15m
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
