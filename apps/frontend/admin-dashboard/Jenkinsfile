pipeline {
    agent any
    
    environment {
        IMAGE_NAME = 'eyesforu-frontend'
    }

    stages {
        stage('Frontend Build') {
            when {
                // 💡 관리자 대시보드 폴더에 변경이 있을 때만 실행
                changeset "apps/admin-dashboard/**" 
            }
            steps {
                dir('apps/admin-dashboard') {
                    echo "🚀 프론트엔드(대시보드) 빌드를 시작합니다..."
                    // npm 설치 및 빌드 (현재 Dockerfile에서 빌드한다면 이 단계는 생략해도 됩니다)
                    // sh 'npm install'
                    // sh 'npm run build'
                }
            }
        }
        
        stage('Docker Build & Deploy') {
            when {
                changeset "apps/admin-dashboard/**"
            }
            steps {
                dir('apps/admin-dashboard') {
                    echo "🐳 프론트엔드 도커 배포를 시작합니다..."
                    
                    sh '''
                        docker stop ${IMAGE_NAME} || true
                        docker rm ${IMAGE_NAME} || true
                        docker rmi ${IMAGE_NAME} || true
                        
                        docker build -t ${IMAGE_NAME} .
                        
                        # 💡 프론트엔드 포트에 맞게 3000:80 등 수정 필요
                        docker run -d -p 3000:80 --name ${IMAGE_NAME} \
                          -e TZ=Asia/Seoul \
                          ${IMAGE_NAME}
                    '''
                }
            }
        }
    }
    
    // 매터모스트 알림
    post {
        success {
            mattermostSend color: '#00d1b2', 
            message: """### 🎊 배포 완료! [프론트엔드 - 대시보드] 🎊
            > **📦 프로젝트:** `${env.JOB_NAME}` (Build **#${env.BUILD_NUMBER}**)
            > **🌱 브랜치:** `${env.gitlabSourceBranch ?: 'dev'}`
            > **👤 작업자:** ${env.gitlabUserName ?: 'GitLab Webhook'}

            🚀 **변경 사항이 서버에 정상적으로 반영되었습니다!**
            🔍 [Jenkins에서 빌드 로그 확인하기](${env.BUILD_URL})"""
        }
        failure {
            mattermostSend color: '#ff3860', 
            message: """### 🚨 배포 실패! [프론트엔드 - 대시보드] 🚨
            > **📦 프로젝트:** `${env.JOB_NAME}` (Build **#${env.BUILD_NUMBER}**)
            > **🌱 브랜치:** `${env.gitlabSourceBranch ?: 'dev'}`
            > **👤 작업자:** ${env.gitlabUserName ?: 'GitLab Webhook'}

            🛠️ **빌드 중 에러가 발생했습니다. 아래 링크에서 원인을 확인해주세요.**
            🔍 [Jenkins에서 에러 로그 확인하기](${env.BUILD_URL})"""
        }
    }
}