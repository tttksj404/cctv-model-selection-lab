pipeline {
    agent any
    
    environment {
        IMAGE_NAME = 'eyesforu-frontend-reporter'
    }

    stages {
        stage('Frontend Build') {
            when {
                // 💡 신고자 웹 폴더에 변경이 있을 때만 실행
                changeset "apps/frontend/reporter-web/**" 
            }
            steps {
                dir('apps/frontend/reporter-web') {
                    echo "🚀 프론트엔드(신고자 웹) 빌드를 시작합니다..."
                }
            }
        }
        
        stage('Docker Build & Deploy') {
            when {
                changeset "apps/frontend/reporter-web/**"
            }
            steps {
                dir('apps/frontend/reporter-web') {
                    echo "🐳 프론트엔드(신고자 웹) 도커 배포를 시작합니다..."
                    
                    sh '''
                        docker stop ${IMAGE_NAME} || true
                        docker rm ${IMAGE_NAME} || true
                        docker rmi ${IMAGE_NAME} || true
                        
                        docker build -t ${IMAGE_NAME} .
                        
                        # 💡 관리자용 포트(3000)와 겹치지 않게 3001로 설정
                        docker run -d -p 3001:80 --name ${IMAGE_NAME} \
                          -e TZ=Asia/Seoul \
                          ${IMAGE_NAME}
                    '''
                }
            }
        }
    }
    
    // 매터모스트 알림
    post {
        success {
            mattermostSend color: '#00d1b2', 
            message: """### 🎊 배포 완료! [백엔드] 🎊
            > **📦 프로젝트:** `${env.JOB_NAME}` (Build **#${env.BUILD_NUMBER}**)
            > **🌱 브랜치:** `${env.gitlabSourceBranch ?: 'dev'}`
            > **👤 작업자:** ${env.gitlabUserName ?: 'GitLab Webhook'}

            🚀 **변경 사항이 서버에 정상적으로 반영되었습니다!**
            🔍 [Jenkins에서 빌드 로그 확인하기](${env.BUILD_URL})"""
        }
        failure {
            mattermostSend color: '#ff3860', 
            message: """### 🚨 배포 실패! [백엔드] 🚨
            > **📦 프로젝트:** `${env.JOB_NAME}` (Build **#${env.BUILD_NUMBER}**)
            > **🌱 브랜치:** `${env.gitlabSourceBranch ?: 'dev'}`
            > **👤 작업자:** ${env.gitlabUserName ?: 'GitLab Webhook'}

            🛠️ **빌드 중 에러가 발생했습니다. 아래 링크에서 원인을 확인해주세요.**
            🔍 [Jenkins에서 에러 로그 확인하기](${env.BUILD_URL})"""
        }
    }
}