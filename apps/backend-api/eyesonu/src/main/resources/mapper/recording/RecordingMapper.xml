<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.eyesonu.recording.mapper.RecordingMapper">

    <resultMap id="recordingResultMap" type="com.ssafy.eyesonu.recording.domain.Recording">
        <id property="id" column="id"/>
        <result property="cameraId" column="camera_id"/>
        <result property="startTime" column="start_time"/>
        <result property="endTime" column="end_time"/>
        <result property="s3Key" column="s3_key"/>
        <result property="fileSize" column="file_size"/>
        <result property="uploadStatus" column="upload_status" javaType="com.ssafy.eyesonu.recording.domain.UploadStatus"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="recordingColumns">
        id,
        camera_id,
        start_time,
        end_time,
        s3_key,
        file_size,
        upload_status,
        created_at
    </sql>

    <insert id="insert"
            parameterType="com.ssafy.eyesonu.recording.domain.Recording"
            useGeneratedKeys="true"
            keyProperty="id"
            keyColumn="id">
        INSERT INTO recordings (
            camera_id,
            start_time,
            end_time,
            s3_key,
            file_size,
            upload_status
        ) VALUES (
            #{cameraId},
            #{startTime},
            #{endTime},
            #{s3Key},
            #{fileSize},
            #{uploadStatus}
        )
    </insert>

    <select id="findById" resultMap="recordingResultMap">
        SELECT <include refid="recordingColumns"/>
        FROM recordings
        WHERE id = #{id}
    </select>

    <select id="findByS3Key" resultMap="recordingResultMap">
        SELECT <include refid="recordingColumns"/>
        FROM recordings
        WHERE s3_key = #{s3Key}
    </select>

    <select id="findAll" resultMap="recordingResultMap">
        SELECT <include refid="recordingColumns"/>
        FROM recordings
        <where>
            <if test="cameraId != null">
                AND camera_id = #{cameraId}
            </if>
            <if test="uploadStatus != null">
                AND upload_status = #{uploadStatus}
            </if>
            <if test="startFrom != null">
                AND start_time &gt;= #{startFrom}
            </if>
            <if test="startTo != null">
                AND start_time &lt;= #{startTo}
            </if>
        </where>
        ORDER BY start_time DESC
    </select>

    <update id="updateUploadStatusAndFileSize">
        UPDATE recordings
        SET upload_status = #{uploadStatus},
            file_size = #{fileSize}
        WHERE id = #{id}
    </update>

</mapper>
