pipeline {
    agent any
    
    environment {
        // 도커 이미지 이름 설정
        IMAGE_NAME = 'eyesforu-backend'
    }

    stages {
        stage('Build & Test') {
            when {
                // 💡 apps/backend-api/eyesonu 폴더에 변경이 있을 때만 실행!
                changeset "apps/backend-api/eyesonu/**"
            }
            steps {
                dir('apps/backend-api/eyesonu') { // 💡 해당 폴더 안으로 이동해서 실행
                    echo "🛠️ 백엔드 빌드를 시작합니다..."
                    // (주의: H2 DB 설정이 아직 안 되었다면 'mvn clean package -DskipTests' 로 테스트를 건너뛰셔도 됩니다)
                    sh 'mvn clean package' 
                }
            }
        }
        
        stage('Docker Build & Deploy') {
            when {
                changeset "apps/backend-api/eyesonu/**"
            }
            steps {
                dir('apps/backend-api/eyesonu') { // 💡 배포할 때도 폴더 안으로 이동
                    echo "🐳 도커 이미지 빌드 및 배포를 시작합니다..."
                    
                    // 1. 기존 컨테이너 및 이미지 삭제 (오류 무시)
                    sh '''
                        docker stop ${IMAGE_NAME} || true
                        docker rm ${IMAGE_NAME} || true
                        docker rmi ${IMAGE_NAME} || true
                    '''
                    
                    // 2. 새 이미지 빌드 및 실행 (포트 8080:8080)
                    sh '''
                        docker build -t ${IMAGE_NAME} .
                        docker run -d -p 8080:8080 --name ${IMAGE_NAME} \
                          -e TZ=Asia/Seoul \
                          ${IMAGE_NAME}
                    '''
                }
            }
        }
    }

// 매터모스트 알림
    post {
        success {
            script {
                def triggerType = env.gitlabActionType ?: (env.gitlabMergeRequestIid ? 'MERGE_REQUEST' : 'PUSH')
                mattermostSend color: '#00d1b2', message: """### 🎊 배포 완료! [백엔드] 🎊
> **📦 빌드 번호:** Build **#${env.BUILD_NUMBER}**
> **⚡ 트리거 유형:** `${triggerType}`
> **🌿 작업 브랜치:** `${env.gitlabSourceBranch ?: env.gitlabBranch ?: '수동 빌드'}`
> **🎯 반영 브랜치:** `${env.gitlabTargetBranch ?: env.gitlabBranch ?: '수동 빌드'}`
> **👤 작업자:** `${env.gitlabUserEmail ?: env.gitlabUserName ?: '수동 실행'}`

🚀 **변경 사항이 서버에 정상적으로 반영되었습니다!**
🔍 [Jenkins에서 빌드 로그 확인하기](http://i15a204.p.ssafy.io/job/${env.JOB_NAME}/${env.BUILD_NUMBER}/)"""
            }
        }
        failure {
            script {
                def triggerType = env.gitlabActionType ?: (env.gitlabMergeRequestIid ? 'MERGE_REQUEST' : 'PUSH')
                mattermostSend color: '#ff3860', message: """### 🚨 배포 실패! [백엔드] 🚨
> **📦 빌드 번호:** Build **#${env.BUILD_NUMBER}**
> **⚡ 트리거 유형:** `${triggerType}`
> **🌿 작업 브랜치:** `${env.gitlabSourceBranch ?: env.gitlabBranch ?: '수동 빌드'}`
> **🎯 반영 브랜치:** `${env.gitlabTargetBranch ?: env.gitlabBranch ?: '수동 빌드'}`
> **👤 작업자:** `${env.gitlabUserEmail ?: env.gitlabUserName ?: '수동 실행'}`

🛠️ **빌드 중 에러가 발생했습니다. 아래 링크에서 원인을 확인해주세요.**
🔍 [Jenkins에서 에러 로그 확인하기](http://i15a204.p.ssafy.io/job/${env.JOB_NAME}/${env.BUILD_NUMBER}/)"""
            }
        }
    }
}
