pipeline {
    agent any
    
    environment {
        // 도커 이미지 이름 설정
        IMAGE_NAME = 'eyesforu-backend'
    }

    stages {
        stage('Build & Test') {
            when {
                // 💡 apps/backend/eyesforu 폴더에 변경이 있을 때만 실행!
                changeset "apps/backend/eyesforu/**" 
            }
            steps {
                dir('apps/backend/eyesforu') { // 💡 해당 폴더 안으로 이동해서 실행
                    echo "🛠️ 백엔드 빌드를 시작합니다..."
                    // (주의: H2 DB 설정이 아직 안 되었다면 'mvn clean package -DskipTests' 로 테스트를 건너뛰셔도 됩니다)
                    sh 'mvn clean package' 
                }
            }
        }
        
        stage('Docker Build & Deploy') {
            when {
                changeset "apps/backend/eyesforu/**"
            }
            steps {
                dir('apps/backend/eyesforu') { // 💡 배포할 때도 폴더 안으로 이동
                    echo "🐳 도커 이미지 빌드 및 배포를 시작합니다..."
                    
                    // 1. 기존 컨테이너 및 이미지 삭제 (오류 무시)
                    sh '''
                        docker stop ${IMAGE_NAME} || true
                        docker rm ${IMAGE_NAME} || true
                        docker rmi ${IMAGE_NAME} || true
                    '''
                    
                    // 2. 새 이미지 빌드 및 실행 (포트 8080:8080)
                    sh '''
                        docker build -t ${IMAGE_NAME} .
                        docker run -d -p 8080:8080 --name ${IMAGE_NAME} \
                          -e TZ=Asia/Seoul \
                          ${IMAGE_NAME}
                    '''
                }
            }
        }
    }
    
    // 매터모스트 알림 (어떤 브랜치, 누가 했는지 포함)
    post {
        success {
            mattermostSend color: '#28a745', 
            message: """✅ **[백엔드 배포 성공]** 
            * **프로젝트:** ${env.JOB_NAME} #${env.BUILD_NUMBER}
            * **브랜치:** `${env.gitlabTargetBranch ?: env.GIT_BRANCH}` 
            * **작업자:** ${env.gitlabUserName ?: 'GitLab'}
            🚀 변경 사항이 서버에 정상적으로 반영되었습니다."""
        }
        failure {
            mattermostSend color: '#dc3545', 
            message: """🚨 **[백엔드 배포 실패]** 
            * **프로젝트:** ${env.JOB_NAME} #${env.BUILD_NUMBER}
            * **브랜치:** `${env.gitlabTargetBranch ?: env.GIT_BRANCH}`
            * **작업자:** ${env.gitlabUserName ?: '알 수 없음'}
            🛠️ 코드를 확인해 주세요!"""
        }
    }
}