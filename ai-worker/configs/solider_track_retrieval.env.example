# Image-reference candidate search profile.
#
# This is an example only. Copy the values into the worker's local environment
# when the request contains a reference image. Do not commit real credentials.
# Prompt-only requests use the CLIP/attribute path and must be evaluated with a
# separate text-query benchmark; they must not be reported as SOLIDER results.

# Make the identity evidence the primary ranking signal.
QWEN_CANDIDATE_REID_WEIGHT=1.0
QWEN_CANDIDATE_CLIP_WEIGHT=0.0

# The notebook worker uses MultiModelCandidateEngine. When a reference image
# is present, make SOLIDER the ranking score there as well; attributes/Qwen
# remain evidence and review signals. Prompt-only requests fall back safely.
QWEN_CANDIDATE_IDENTITY_PRIMARY_RETRIEVAL=true

# Aggregate a persistent tracker track before ranking identities.
QWEN_CANDIDATE_AGGREGATE_TOP_FRAMES=3
QWEN_CANDIDATE_TOP_K=5
