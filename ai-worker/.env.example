QWEN_PROVIDER=mock
QWEN_ENVIRONMENT=development
QWEN_SERVER_HOST=127.0.0.1
QWEN_SERVER_PORT=8080
QWEN_MODEL_PATH=./models/Qwen3-VL-8B-Instruct
QWEN_IMAGE_ROOT=./data/candidates
QWEN_MODEL_VERSION=Qwen3-VL-8B-Instruct
QWEN_MAX_NEW_TOKENS=<redacted>
QWEN_DEVICE_MAP=auto
# The local worker reuses the Qwen loader from the existing qwen3vl-backend
# comparison runtime: Qwen3VLForConditionalGeneration + AutoProcessor.
# Keep the safe mock default above for deployments without a checkpoint. For
# this laptop, put the following active values in the private env file:
# QWEN_PROVIDER=qwen
# QWEN_MODEL_PATH=<local-user-path>/Desktop/2학기/qwen3vl-backend/experiments/models/Qwen3-VL-2B-Instruct
# QWEN_MODEL_VERSION=Qwen3-VL-2B-Instruct-legacy-loader
# QWEN_MAX_NEW_TOKENS=128
# QWEN_INTERNAL_API_KEY=inject-from-secret-store
# QWEN_PROBABILITY_EVIDENCE_SIGNING_KEY=inject-at-least-32-random-characters
QWEN_PROBABILITY_REQUEST_MAX_AGE_SECONDS=300
QWEN_PROBABILITY_REQUEST_FUTURE_SKEW_SECONDS=30
QWEN_PROBABILITY_REPLAY_CACHE_SIZE=10000
QWEN_INFERENCE_CONCURRENCY=2
QWEN_INFERENCE_QUEUE_TIMEOUT_MS=500
QWEN_FLORENCE_ENABLED=false
QWEN_FLORENCE_MODEL_PATH=./models/Florence-2-large
QWEN_FLORENCE_MODEL_VERSION=microsoft/Florence-2-large
QWEN_FLORENCE_MAX_NEW_TOKENS=<redacted>
QWEN_FLORENCE_DEVICE_MAP=auto
QWEN_FLORENCE_ATTRIBUTE_PROMPT_VERSION=florence-attributes-v1

# Central AI search candidate runtime
QWEN_CANDIDATE_MODEL_KEY=<redacted>
QWEN_CANDIDATE_DEVICE=cuda
QWEN_CANDIDATE_MODEL_DIRECTORY=./models
QWEN_CANDIDATE_MODEL_MANIFEST=./configs/realtime_model_manifest.json
QWEN_CANDIDATE_YOLO_WEIGHTS=models/yolo11x.pt
QWEN_CANDIDATE_TRACKER=bytetrack.yaml
QWEN_CANDIDATE_REID_CHECKPOINT=models/solider_reid/swin_base_msmt17.pth
SOLIDER_REID_ROOT=external/SOLIDER-REID-runtime-8c08e1c
QWEN_CANDIDATE_CLIP_CHECKPOINT=openai/clip-vit-large-patch14
QWEN_CANDIDATE_CLIP_REVISION=32bd64288804d66eefd0ccbe215aa642df71cc41
QWEN_CANDIDATE_CLIP_CACHE_DIR=artifacts/ai-worker/model-cache/clip
# The worker loads the local HF snapshot only; provision it before consuming jobs.
QWEN_CANDIDATE_CLIP_LOCAL_FILES_ONLY=true
QWEN_CANDIDATE_TOP_K=20
QWEN_CANDIDATE_MAX_CROPS_PER_TRACK=12
QWEN_CANDIDATE_DETECTOR_CONFIDENCE=0.25
QWEN_CANDIDATE_FRAME_STRIDE=3
QWEN_CANDIDATE_SAMPLE_EVERY_SECONDS=0.75
QWEN_CANDIDATE_CROP_MARGIN=0.05
# Do not emit a candidate or send it to Qwen unless the YOLO person crop is
# large enough to be a readable person-evidence frame.
QWEN_CANDIDATE_MIN_PERSON_CROP_QUALITY=0.40
QWEN_CANDIDATE_REID_WEIGHT=0.75
QWEN_CANDIDATE_CLIP_WEIGHT=0.25
QWEN_CANDIDATE_AGGREGATE_TOP_FRAMES=3
QWEN_CANDIDATE_REID_BATCH_SIZE=32
# Recording-path ensemble gates.  The color gate is fail-closed for an
# explicitly requested upper/lower color; tune only with held-out CCTV data.
QWEN_CANDIDATE_MIN_OUTPUT_SCORE=0.30
QWEN_CANDIDATE_COLOR_REJECT_THRESHOLD=0.35
# Optional fine-attribute heads are auto-discovered below
# <QWEN_CANDIDATE_MODEL_DIRECTORY>/../experiments/models.  Set explicit paths
# only when the deployment stores them elsewhere.
# QWEN_CANDIDATE_PETA_HEAD=/path/to/clip_vitl14_peta_finetuned_head.pt
# QWEN_CANDIDATE_PA100K_HEAD=/path/to/clip_vitl14_pa100k_finetuned_head.pt
# Optional SOLIDER Swin-B PAR linear head.  The remote-only manifest is not a
# runtime checkpoint; copy a verified local artifact before enabling it.
# QWEN_CANDIDATE_SOLIDER_PAR_HEAD=/path/to/solider_pa100k_head.pt
# Optional case anchors and historical target gallery.  A no-photo job stays
# attribute-first until a confirmed crop is placed under case-<caseId>/.
# QWEN_CANDIDATE_ANCHOR_DIR=artifacts/ai-worker/case-anchors
# QWEN_CANDIDATE_HISTORICAL_GALLERY_DIR=artifacts/ai-worker/historical-gallery
QWEN_CANDIDATE_QWEN_REVIEW_ENABLED=true
QWEN_CANDIDATE_QWEN_REVIEW_TOP_K=5
# Qwen review can stay local, or use an OpenAI-compatible vLLM endpoint on
# the GPU server.  The remote endpoint must expose /v1/chat/completions.
# QWEN_CANDIDATE_QWEN_REVIEW_PROVIDER=remote
# QWEN_CANDIDATE_QWEN_REMOTE_BASE_URL=http://gpu-server:8000/v1
# QWEN_CANDIDATE_QWEN_REMOTE_MODEL=qwen-active
# QWEN_CANDIDATE_QWEN_REMOTE_API_KEY=inject-from-secret-store
# QWEN_CANDIDATE_QWEN_REMOTE_TIMEOUT_SECONDS=90

# Notebook-hosted AI Worker. The central server base URL must be reachable from this notebook.
EYESONU_AI_WORKER_CENTRAL_API_URL=http://127.0.0.1:8080
EYESONU_AI_WORKER_API_KEY=<redacted>
# Primary backend contract: RecordingAnalysisWorkerController and X-Worker-Key.
# Existing laptop-secret aliases are also accepted: CENTRAL_API_BASE_URL and
# X-Worker-Key. CENTRAL_API_WORKER_KEY is accepted only when it contains the
# Worker Key, not the media-server Device Key.
EYESONU_AI_WORKER_AUTH_MODE=worker
EYESONU_AI_WORKER_ID=notebook-local-01
EYESONU_AI_WORKER_MODEL_KEY=<redacted>
EYESONU_AI_WORKER_HEARTBEAT_INTERVAL_SECONDS=20
# Set this only when the notebook can reach RabbitMQ through VPN, AMQPS, or an
# SSH tunnel. Do not expose raw port 5672 to the public internet.
# RABBITMQ VHOST가 /eyesonu이면 URI에서는 %2Feyesonu로 인코딩한다.
# EYESONU_AI_WORKER_RABBITMQ_URL=amqps://worker-user:secret@broker.example/%2Feyesonu
# Existing laptop-secret aliases are also accepted: RABBITMQ_URL and
# RABBITMQ_QUEUE.
EYESONU_AI_WORKER_RABBITMQ_QUEUE=search.target.recording.queue
# The worker is intentionally single-delivery only. A value other than 1 is
# rejected at startup so one GPU process cannot hold multiple job leases.
EYESONU_AI_WORKER_RABBITMQ_PREFETCH_COUNT=1
# One notebook GPU must run one worker process. A second launch exits before
# model warm-up and cannot consume another recording job.
EYESONU_AI_WORKER_SINGLE_INSTANCE=true
# Optional: override the lock location. By default it is cache_dir/worker.lock.
# EYESONU_AI_WORKER_INSTANCE_LOCK_FILE=artifacts/ai-worker/cache/worker.lock
EYESONU_AI_WORKER_RABBITMQ_RECONNECT_DELAY_SECONDS=5
# Retry messages are published to the backend-declared TTL buckets. Keep this
# list identical to recording.analysis.retry-delay-buckets-seconds on the backend.
# This is a routing-key prefix, not the name of one shared retry queue.
EYESONU_AI_WORKER_RABBITMQ_RETRY_EXCHANGE=search.target.recording.retry.exchange
EYESONU_AI_WORKER_RABBITMQ_RETRY_ROUTING_KEY_PREFIX=<redacted>
EYESONU_AI_WORKER_RABBITMQ_RETRY_DELAY_SECONDS=5
EYESONU_AI_WORKER_RABBITMQ_RETRY_DELAY_BUCKETS_SECONDS=5,15,30,60,300
EYESONU_AI_WORKER_RABBITMQ_MAX_RETRY_ATTEMPTS=20
EYESONU_AI_WORKER_CACHE_DIR=artifacts/ai-worker/cache
EYESONU_AI_WORKER_OUTPUT_DIR=artifacts/ai-worker/jobs
EYESONU_AI_WORKER_MAX_DOWNLOAD_BYTES=5368709120
EYESONU_AI_WORKER_MAX_EVIDENCE_UPLOAD_BYTES=10485760
# Number of candidate frame/crop pairs uploaded concurrently. Keep bounded for MinIO/S3.
EYESONU_AI_WORKER_EVIDENCE_UPLOAD_CONCURRENCY=4
# Prefer a signed-URL FFmpeg time window over persisting the complete recording.
# Set to analyze only when a storage proxy cannot seek/range-read media objects.
EYESONU_AI_WORKER_DOWNLOAD_WINDOW_MODE=segment
EYESONU_AI_WORKER_FFMPEG_PATH=ffmpeg
EYESONU_AI_WORKER_SEGMENT_TIMEOUT_SECONDS=900
# Legacy enriched Rabbit events carry recordingObjectKey instead of a signed
# download URL. Configure the private MinIO/S3 bucket only when that contract
# is used; credentials are never sent to the central API.
# EYESONU_AI_WORKER_STORAGE_ENDPOINT=http://127.0.0.1:9000
# EYESONU_AI_WORKER_STORAGE_BUCKET=eyesonu-media
# EYESONU_AI_WORKER_STORAGE_REGION=ap-northeast-2
# EYESONU_AI_WORKER_STORAGE_ACCESS_KEY=inject-from-local-secret-store
# EYESONU_AI_WORKER_STORAGE_SECRET_KEY=inject-from-local-secret-store
# EYESONU_AI_WORKER_STORAGE_PATH_STYLE=true
EYESONU_AI_WORKER_MAX_CONNECTIONS=20
EYESONU_AI_WORKER_MAX_KEEPALIVE_CONNECTIONS=8
EYESONU_AI_WORKER_KEEPALIVE_EXPIRY_SECONDS=30
# Keep this at 0 for claim/heartbeat/complete/fail POSTs unless the API contract
# explicitly defines safe retry semantics.
EYESONU_AI_WORKER_TRANSPORT_RETRIES=0
EYESONU_AI_WORKER_CONNECT_TIMEOUT_SECONDS=5
EYESONU_AI_WORKER_READ_TIMEOUT_SECONDS=30
EYESONU_AI_WORKER_WRITE_TIMEOUT_SECONDS=10
EYESONU_AI_WORKER_POOL_TIMEOUT_SECONDS=10
EYESONU_AI_WORKER_DOWNLOAD_READ_TIMEOUT_SECONDS=120
EYESONU_AI_WORKER_DOWNLOAD_CHUNK_BYTES=1048576

